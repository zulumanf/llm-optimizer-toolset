# Single .env file — copy to .env and fill in. Never commit .env (docs/10-security.md).

# Local dev database (Homebrew postgresql@14 runs on port 5433)
DATABASE_URL=postgres://localhost:5433/llm_optimizer_dev
TEST_DATABASE_URL=postgres://localhost:5433/llm_optimizer_test

# Auth mode: "dev" (local single-user, no Supabase needed) or "supabase"
AUTH_MODE=dev
DEV_USER_EMAIL=you@example.com
DEV_USER_NAME=Dev User
DEV_USER_ROLE=admin

# Supabase (required when AUTH_MODE=supabase — see DECISIONS.md 2026-07-27 auth entry)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# AI providers (required for real runs; the mock provider needs no keys)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=      # Gemini provider adapter (lib/ai/google.ts)
# PERPLEXITY_API_KEY=  # enrichment/discovery/market research (specs 079-082)

# Shared secret for POST /api/cron/weekly-baseline (docs/10)
# CRON_SECRET=

# Automation layer — connector credential encryption (AES-256-GCM).
# Generate with: openssl rand -base64 32
# Without it, connector credentials cannot be stored or read: the layer fails
# closed rather than keeping secrets in the clear.
AUTOMATION_CREDENTIAL_KEY=

# Gmail OAuth client (spec 091) — used ONLY by scripts/connect-gmail.ts to
# mint the sending mailbox's connection; the app itself reads tokens from
# the encrypted connector store. From Google Cloud console (OAuth client,
# type Web application, redirect http://localhost:8791/callback).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Public origin of the deployed app (no trailing slash). Audit share links,
# outreach drafts, and the GH-Actions heartbeat all build from this.
# APP_URL=
# Scheduling page for the private report's final CTA (spec 128). Unset → the CTA opens a prefilled reply email.
# AUDIT_BOOKING_URL=

# Operator webhook (Slack-compatible): work digests + system alerts (spec 059)
# DIGEST_WEBHOOK_URL=

# MCP server actor id (spec 033) — only `npm run mcp` needs it
# MCP_USER_ID=

# Portfolio-wide 24h LLM spend ceiling in USD (default 25; spec 050 widened
# it to include agent-path calls, not just benchmark runs)
# DAILY_SPEND_CEILING_USD=25

# Prospect audit page: commission-estimate rate (default 0.025) and display
# credibility fields. The outbound sender of record is configured in-app
# (outreach_sender_identity, spec 052) — these are page display only.
# COMMISSION_RATE_ESTIMATE=0.025
# SENDER_COMPANY=
# SENDER_CREDENTIAL=

# Test/demo fences (spec 050). NEVER set in production: PROVIDER lets the
# mock run; SCORING additionally lets its fabrications into score rows
# (refused under AUTH_MODE=supabase regardless).
# ALLOW_MOCK_PROVIDER=1
# ALLOW_MOCK_SCORING=1

# Backups (spec 059). Production MUST set the encryption key — the dump
# contains prospect PII. Generate: openssl rand -base64 32
# BACKUP_ENCRYPTION_KEY=
# The uploader receives the artifact path as $1, e.g.:
#   rclone copy "$1" remote:avos-backups/
# BACKUP_UPLOAD_CMD=

# Operator egress IPs (comma-separated) whose audit views are labeled
# internal — logged-out opens from your own machines must not read as
# prospect interest (spec 095/096 follow-up).
# INTERNAL_VIEW_IPS=
