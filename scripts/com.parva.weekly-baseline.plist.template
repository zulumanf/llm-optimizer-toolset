<?xml version="1.0" encoding="UTF-8"?>
<!--
  Weekly baseline scheduler (macOS launchd). Fires Mondays 09:00 local.

  Install:
    1. Replace __CRON_SECRET__ with the value from .env
    2. cp scripts/com.parva.weekly-baseline.plist.template \
         ~/Library/LaunchAgents/com.parva.weekly-baseline.plist
    3. launchctl load ~/Library/LaunchAgents/com.parva.weekly-baseline.plist

  Caveat (be honest about it): this only fires when the machine is awake
  AND `npm run app` is serving on :3000. On a laptop that is unreliable —
  the durable answer is deploying the app and using a hosted scheduler
  (e.g. Vercel Cron), which the same endpoint already supports. If a week
  is missed, nothing breaks: the endpoint is idempotent per period and the
  operator can start the baseline run manually from the Runs page.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.parva.weekly-baseline</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/curl</string>
    <string>-fsS</string>
    <string>-X</string>
    <string>POST</string>
    <string>-H</string>
    <string>Authorization: Bearer __CRON_SECRET__</string>
    <string>http://localhost:3000/api/cron/weekly-baseline</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/parva-weekly-baseline.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/parva-weekly-baseline.err</string>
</dict>
</plist>
